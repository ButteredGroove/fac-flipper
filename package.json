{
  "name": "fac-flipper",
  "version": "0.0.25",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky",
    "test": "vitest --run",
    "test:browser": "playwright test"
  },
  "lint-staged": {
    "*.{css,html,js,json,md}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "dependencies": {
    "papaparse": "^5.5.3"
  }
}
