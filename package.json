{
  "name": "fac-flipper",
  "version": "0.0.4",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,json,md}": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "dependencies": {
    "papaparse": "^5.5.3"
  }
}
