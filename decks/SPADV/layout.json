{
  "card": {
    "orientation": "portrait",
    "grid": { "cols": 12, "rows": 16 },
    "size": { "width": 250 },
    "padding_x": 2,
    "text_scale": 1
  },
  "blocks": [
    {
      "id": "meta",
      "type": "kv",
      "x": 2,
      "y": 1,
      "w": 10,
      "h": 3,
      "items": [
        { "label": "PB", "field": "PB" },
        { "label": "RN", "field": "RN" },
        {
          "label": "Error",
          "field": "Error",
          "styles": {
            "colorRules": [{ "match": "No", "color": "#dc2626" }]
          }
        },
        {
          "label": "Pitch",
          "field": "Pitch",
          "styles": {
            "colorRules": [
              { "match": "Yes", "color": "#16a34a" },
              { "match": "No", "color": "#dc2626" }
            ]
          }
        }
      ]
    },
    {
      "id": "errors",
      "type": "kv",
      "title": "ERROR TYPE",
      "x": 2,
      "y": 4,
      "w": 10,
      "h": 4,
      "items": [
        { "label": "P", "field": "E P" },
        { "label": "C", "field": "E C" },
        { "label": "IF", "field": "E IF" },
        { "label": "OF", "field": "E OF" }
      ]
    },
    {
      "id": "out",
      "type": "table",
      "x": 1,
      "y": 8,
      "w": 6,
      "h": 8,
      "rowHeader": "CHT",
      "rows": ["RP", "RN", "LP", "LN", "P"],
      "styles": {
        "cellPaddingX": 1,
        "rowHeaderPaddingX": 1,
        "rowHeaderWidth": "2.75ch",
        "hideDivider": true
      },
      "columns": [
        { "header": "OUT", "field_prefix": "O " },
        {
          "header": "CD",
          "field_prefix": "CD ",
          "headerStyles": { "color": "#f97316" }
        }
      ]
    },
    {
      "id": "runner-adv",
      "type": "table",
      "x": 7,
      "y": 8,
      "w": 6,
      "h": 8,
      "rowHeader": "Runner",
      "rowHeaderStyles": { "color": "#2563eb" },
      "styles": {
        "cellPaddingX": 0,
        "rowHeaderPaddingX": 0,
        "rowHeaderWidth": "2.5ch"
      },
      "rows": ["1b7", "1b8", "1b9", "2b"],
      "columns": [
        {
          "header": "Adv",
          "field_prefix": "RADV ",
          "headerStyles": { "color": "#2563eb", "align": "left" },
          "styles": {
            "align": "left",
            "colorRules": [{ "match": "CHAL", "color": "#dc2626" }]
          }
        }
      ]
    }
  ]
}
